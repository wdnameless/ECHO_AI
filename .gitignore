# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local tooling caches
.opencode/


# Signing keys (never commit!)
.tauri-signing-key.txt
.tauri-signing-key.txt.pub

__pycache__/
*.pyc

# Models and large binaries
*.gguf
*.bin
src-tauri/resources/nemotron*
src-tauri/resources/*.gguf
release-resources/*.zip
logs.zip

# The ASR engine binary is tracked on purpose: it is embedded into the app at
# compile time (include_bytes!), so a fresh checkout must build without network
# access. Only the model is excluded — it is downloaded by the user at runtime.
!src-tauri/resources/pluely-asr.exe

src-tauri/resources/asr-port
asr-port

# A 751 MB model a user downloaded for local runs. Untracked by the *.gguf
src-tauri/resources/nemotron-3.5-asr-streaming-0.6b-Q8_0.gguf

# One-off local DB snapshots (pre-migration dumps). Never part of a commit.
/backups/
# Generated architecture reports (tooling output)
.archmap/
src/.archmap/

# Workflow tool state (lane/artifact bookkeeping), not part of the project
/.workflow/

# Local scratch space: throwaway probes, generated audio, build logs.
/.tmp/

# A local database belonging to an unrelated tool (control-room), never part of
# the project: runtime state that would otherwise ride along in every commit.
/data/
